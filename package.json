{
	"name": "n8n-nodes-open-project-api",
	"version": "0.1.9",
	"description": "n8n community node to interact with the OpenProject API",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"open-project"
	],
	"author": {
		"name": "Kamil Biela",
		"email": "biela.kamil@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/biela-kamil/n8n-open-project"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenProjectApi.credentials.js",
			"dist/credentials/WoodpeckerCredentialsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenProject/OpenProject.node.js",
			"dist/nodes/Woodpecker/Woodpecker.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
